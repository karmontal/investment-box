# =============================================================================
# Investment Box -- environment variables
# Copy to .env and fill in. NEVER commit .env. NEVER paste these into chat.
# Every value here overrides the matching key in config/default.yaml.
# Nesting uses a double underscore: IB__RISK__MAX_OPEN_POSITIONS=5
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# paper | live   -- live additionally requires a typed confirmation in the UI
IB__TRADING_MODE=paper
IB__LOG_LEVEL=INFO
# Directory for the SQLite DB, parquet cache and logs
IB__DATA_DIR=./data

# --- Broker: Alpaca ----------------------------------------------------------
# Paper keys from https://app.alpaca.markets/paper/dashboard/overview
# Leave blank to run against the built-in mock broker (Phase 1 default).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets  |  Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Shariah screening provider (Phase 3; Mode B only) -----------------------
# internal_aaoifi | mock_external | zoya | musaffa
IB__SHARIAH__PROVIDER=internal_aaoifi
SHARIAH_API_KEY=
SHARIAH_API_BASE_URL=

# --- Telegram (Phase 2) ------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Broadcast channel id, usually negative, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Comma-separated numeric user ids allowed to command the bot. Everything
# else is ignored and logged. An empty list disables the interactive bot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Localisation ------------------------------------------------------------
# en | ar | both
IB__I18N__LANGUAGE=both
IB__I18N__DISPLAY_TIMEZONE=Asia/Jerusalem
