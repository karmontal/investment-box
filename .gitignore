# Secrets -- never commit
.env
.env.*
!.env.example
config/local.yaml

# Data & state.
# Anchored with a leading slash -- ON PURPOSE. An unanchored `data/` matches at
# EVERY depth in git, so it silently swallowed src/investment_box/data/ and the
# whole data layer was missing from the repository while every local test still
# passed against the untracked files. Note this is NOT how .dockerignore reads
# the same line: there, patterns are already anchored to the build context root.
# Same text, different meaning, and that difference cost a broken deployment.
/data/
*.db
*.db-journal
*.sqlite3
/logs/
/reports/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/dist/
/build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
